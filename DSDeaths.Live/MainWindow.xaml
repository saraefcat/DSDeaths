<Window x:Class="DSDeaths.Live.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DSDeaths Live"
        Width="920" Height="800" MinWidth="780" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/DSDeaths.Live.Icon.png"
        Background="#0D1117" Foreground="#F0F3F6"
        FontFamily="Segoe UI" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#171C24" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#2B3441" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9BA7B4" />
        <SolidColorBrush x:Key="AccentBrush" Color="#D5A847" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="#293241" />
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="BorderBrush" Value="#435064" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1F2733" />
                    <Setter Property="BorderBrush" Value="#60708A" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#161D27" />
                    <Setter Property="BorderBrush" Value="#71839F" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.42" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0F141B" />
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="BorderBrush" Value="#435064" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CaretBrush" Value="White" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#202733" />
            <Setter Property="Foreground" Value="#11151B" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8EBEF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111720" BorderBrush="#273140" BorderThickness="0,0,0,1" Padding="26,19">
            <DockPanel>
                <Image DockPanel.Dock="Left" Source="Assets/DSDeaths.Live.Header.png"
                       Width="54" Height="54" Margin="0,0,16,0" Stretch="Uniform" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubtitleText" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="GameText" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock x:Name="ConnectionText" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" HorizontalAlignment="Right" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border x:Name="EacWarning" Grid.Row="1" Visibility="Collapsed"
                Background="#2C2113" BorderBrush="#8B6728" BorderThickness="0,0,0,1" Padding="26,10">
            <DockPanel>
                <TextBlock Text="⚠" Foreground="#F0C35B" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock x:Name="EacWarningTitleText" Foreground="#F0C35B" FontWeight="Bold" />
                    <TextBlock x:Name="EacWarningBodyText" Foreground="#D9C8A4" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="LeftColumnPanel" Grid.Column="0" Margin="0,0,10,0">
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock x:Name="DeathsLabelText" Foreground="{StaticResource AccentBrush}"
                                       FontSize="13" FontWeight="Bold" />
                            <TextBlock x:Name="DeathCountText" Text="0" FontSize="88" FontWeight="Light"
                                       LineHeight="98" Margin="-4,2,0,0" />
                            <TextBlock x:Name="RawCountText" Foreground="{StaticResource MutedBrush}" FontSize="14" />
                            <Border x:Name="ClampedWarning" Visibility="Collapsed" Background="#332518"
                                    BorderBrush="#6F5228" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,14,0,0">
                                <TextBlock x:Name="ClampedWarningText" Foreground="#E1BE75" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Button x:Name="OverlayButton" Click="OverlayButton_Click" HorizontalAlignment="Stretch"
                            MinHeight="56" VerticalContentAlignment="Center" />

                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,18,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="ResetOverlayPositionButton" DockPanel.Dock="Right"
                                        Click="ResetOverlayPositionButton_Click" Padding="9,4" />
                                <TextBlock x:Name="OverlayAppearanceTitleText" FontSize="17" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <Grid Margin="0,13,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="OverlayScaleLabelText" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock x:Name="OverlayScaleValueText" Grid.Column="1" Foreground="#E8EBEF" />
                                    </Grid>
                                    <Slider x:Name="OverlayScaleSlider" Minimum="50" Maximum="200" TickFrequency="5"
                                            IsSnapToTickEnabled="False" ValueChanged="OverlayScaleSlider_ValueChanged" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="BackgroundOpacityLabelText" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock x:Name="OpacityValueText" Grid.Column="1" Foreground="#E8EBEF" />
                                    </Grid>
                                    <Slider x:Name="OverlayOpacitySlider" Minimum="0" Maximum="100" TickFrequency="5"
                                            IsSnapToTickEnabled="False" ValueChanged="OverlayOpacitySlider_ValueChanged" />
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="0">
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="FontSizeLabelText" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock x:Name="FontSizeValueText" Grid.Column="1" Foreground="#E8EBEF" />
                                    </Grid>
                                    <Slider x:Name="OverlayFontSizeSlider" Minimum="24" Maximum="96" TickFrequency="2"
                                            IsSnapToTickEnabled="False" ValueChanged="OverlayFontSizeSlider_ValueChanged" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock x:Name="FontFamilyLabelText" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                                    <ComboBox x:Name="OverlayFontFamilyComboBox" Height="30"
                                              SelectionChanged="OverlayFontFamilyComboBox_SelectionChanged" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock x:Name="TextColorLabelText" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                                    <Button x:Name="TextColorButton" Click="TextColorButton_Click" HorizontalAlignment="Stretch"
                                            Height="30" Padding="8,0">
                                        <DockPanel>
                                            <Border x:Name="TextColorSwatch" DockPanel.Dock="Left" Width="18" Height="18"
                                                    CornerRadius="3" BorderBrush="#718096" BorderThickness="1" Margin="0,0,8,0" />
                                            <TextBlock x:Name="TextColorValueText" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="2">
                                    <TextBlock x:Name="TextShadowLabelText" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                                    <ComboBox x:Name="OverlayTextShadowComboBox" Height="30"
                                              SelectionChanged="OverlayTextShadowComboBox_SelectionChanged">
                                        <ComboBoxItem Tag="none" />
                                        <ComboBoxItem Tag="soft" />
                                        <ComboBoxItem Tag="strong" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <CheckBox x:Name="OverlayPositionLockedCheckBox"
                                          Click="OverlayPositionLockedCheckBox_Click" />
                                <CheckBox x:Name="OverlayTopmostCheckBox" Grid.Column="2"
                                          Click="OverlayTopmostCheckBox_Click" />
                                <CheckBox x:Name="OverlayShowBorderCheckBox" Grid.Row="2"
                                          Click="OverlayShowBorderCheckBox_Click" />
                                <CheckBox x:Name="OverlayShowLabelCheckBox" Grid.Row="2" Grid.Column="2"
                                          Click="OverlayShowLabelCheckBox_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="RightColumnPanel" Grid.Column="1" Margin="10,0,0,0">
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,18">
                        <StackPanel x:Name="OffsetPanel">
                            <DockPanel>
                                <TextBlock x:Name="OffsetTitleText" FontSize="17" FontWeight="SemiBold" />
                                <Border x:Name="OffsetOnlyBadge" DockPanel.Dock="Right" Background="#272F3B"
                                        CornerRadius="10" Padding="9,3" HorizontalAlignment="Right">
                                    <TextBlock x:Name="OffsetOnlyText" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                </Border>
                            </DockPanel>
                            <CheckBox x:Name="OffsetEnabledCheckBox" Click="OffsetEnabledCheckBox_Click" Margin="0,17,0,13" />
                            <TextBlock x:Name="BaselineLabelText" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
                            <TextBox x:Name="BaselineTextBox" Text="0" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="SetCurrentZeroButton" Click="SetCurrentZeroButton_Click" Margin="0,0,8,0" />
                                <Button x:Name="ApplyOffsetButton" Grid.Column="1" Click="ApplyOffsetButton_Click" />
                            </Grid>
                            <TextBlock x:Name="OffsetHelpText" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="18" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock x:Name="ObsTitleText" FontSize="17" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Ellipse x:Name="OutputStatusDot" Width="9" Height="9" Fill="#42C77A" Margin="0,1,9,0" />
                                <TextBlock x:Name="OutputStatusText" />
                            </StackPanel>
                            <TextBlock x:Name="OutputPathText" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                       Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="OpenOutputFolderButton" Click="OpenOutputFolderButton_Click"
                                        Padding="10,6" />
                                <Button x:Name="CopyOutputPathButton" Grid.Column="2"
                                        Click="CopyOutputPathButton_Click" Padding="10,6" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid x:Name="SettingsPanelsGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    <Border x:Name="DisplaySettingsPanel" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock x:Name="SettingsTitleText" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock x:Name="LanguageLabelText" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,5" />
                            <ComboBox x:Name="LanguageComboBox" SelectionChanged="LanguageComboBox_SelectionChanged">
                                <ComboBoxItem Tag="auto" />
                                <ComboBoxItem Tag="ja" />
                                <ComboBoxItem Tag="en" />
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ApplicationSettingsPanel" Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock x:Name="ApplicationSettingsTitleText" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock x:Name="CloseButtonBehaviorLabelText" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,12,0,5" />
                            <ComboBox x:Name="CloseButtonBehaviorComboBox"
                                      SelectionChanged="CloseButtonBehaviorComboBox_SelectionChanged">
                                <ComboBoxItem Tag="tray" />
                                <ComboBoxItem Tag="exit" />
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="3" Background="#111720" BorderBrush="#273140" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <Button x:Name="CopyStatusButton" DockPanel.Dock="Right" Click="CopyStatusButton_Click"
                        Margin="12,-5,0,-5" Padding="10,5" />
                <Ellipse x:Name="MonitorStatusDot" DockPanel.Dock="Left" Width="9" Height="9" Fill="#84909D" Margin="0,0,10,0" />
                <TextBlock x:Name="MonitorStatusText" Foreground="#CBD2DA" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
